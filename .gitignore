dist/
dist-ssr/
build/
*.tsbuildinfo

# ==================== LOGS ====================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==================== LOCAL DATA / DB DUMPS ====================
data/
*.sqlite
*.db
pgdump/
backups/
*.backup

# ==================== OS ====================
.DS_Store
Thumbs.db
desktop.ini

# ==================== EDITORS / IDE ====================
.idea/
*.swp
*.swo
